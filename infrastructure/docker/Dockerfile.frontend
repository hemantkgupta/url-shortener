# =============================================================================
# Dockerfile.frontend — React SPA
# =============================================================================
# Multi-stage build:
#   Stage 1 (builder): installs npm dependencies and produces the Vite/CRA dist
#   Stage 2 (runtime): lightweight nginx:alpine serving the static bundle
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build the React application
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

ARG URL_SHORTENER_FRONTEND_BASE_PATH=/
ENV URL_SHORTENER_FRONTEND_BASE_PATH=${URL_SHORTENER_FRONTEND_BASE_PATH}
ARG URL_SHORTENER_AUTH_GOOGLE_CLIENT_ID=
ENV URL_SHORTENER_AUTH_GOOGLE_CLIENT_ID=${URL_SHORTENER_AUTH_GOOGLE_CLIENT_ID}

# Install dependencies first (layer-cached unless package*.json changes)
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

# Copy the rest of the frontend source and build
COPY frontend/ .

# Produces /app/dist (Vite) or /app/build (CRA)
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Serve with nginx
# ---------------------------------------------------------------------------
FROM nginx:alpine

# Remove the default nginx config and install ours
RUN rm /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/app.conf

# Copy the compiled static assets
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx runs as root by default; the official image already drops privileges
# for worker processes. Expose standard HTTP port.
EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost/health 2>/dev/null | grep -q "ok" || exit 1

CMD ["nginx", "-g", "daemon off;"]
