# Domain and storage
URL_SHORTENER_PUBLIC_DOMAIN=short.example.com
URL_SHORTENER_DATA_ROOT=/data/server/url-shortener

# Authentication
URL_SHORTENER_AUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public gateway ports
URL_SHORTENER_HTTP_PORT=80
URL_SHORTENER_HTTPS_PORT=443

# Datastore preference
# Set to "scylla" first. If ARM64 compatibility becomes a problem on the target
# host, switch to "cassandra" once the one-box compose pack supports it.
URL_SHORTENER_PRIMARY_WIDE_COLUMN_STORE=scylla
