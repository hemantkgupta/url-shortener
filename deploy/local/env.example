# Copy relevant values into ~/.url-shortener-local-dev for local development.

# Google OAuth client ID shared by frontend and backend services.
URL_SHORTENER_AUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional local port overrides.
# URL_SHORTENER_FRONTEND_PORT=13000
# URL_SHORTENER_REDIRECT_SERVICE_PORT=18080
# URL_SHORTENER_KEY_GENERATION_SERVICE_PORT=18081
# URL_SHORTENER_WRITE_SERVICE_PORT=18082
# URL_SHORTENER_ANALYTICS_SERVICE_PORT=18083

# Optional domain override for generated links in local development.
# OWN_DOMAIN=localhost:13000/r

# Optional KGS override for local experiments.
# KGS_BASE_URL=http://localhost:18081
